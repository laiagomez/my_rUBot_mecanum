[Unit]
Description=My Robot bringup (ROS 2)
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target
Requires=sys-subsystem-net-devices-wlan0.device
After=sys-subsystem-net-devices-wlan0.device

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/my_rUBot_mecanum
EnvironmentFile=/home/ubuntu/my_rUBot_mecanum/tools/robot_installation/Local_service/robot.env
ExecStart=/home/ubuntu/my_rUBot_mecanum/tools/robot_installation/Local_service/start_robot.sh
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
