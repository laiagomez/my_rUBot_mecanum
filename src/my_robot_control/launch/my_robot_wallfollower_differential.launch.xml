<?xml version="1.0"?>
<launch>
    <!-- ========================
         Launch Arguments
         ======================== -->
    <arg name="follow_distance" default="0.30" />
    <arg name="tolerance"       default="0.05" />
    <arg name="right_detection_limit" default="1.0" />
    <arg name="forward_speed"   default="0.30" />
    <arg name="turn_speed"      default="0.50" />

    <!-- ========================
         Node Definition
         ======================== -->
    <node
        pkg="my_robot_control"
        exec="my_robot_wallfollower_differential_exec"
        name="differential_wall_follower"
        output="screen">

        <!-- Pass arguments as parameters -->
        <param name="follow_distance" value="$(var follow_distance)" />
        <param name="tolerance" value="$(var tolerance)" />
        <param name="right_detection_limit" value="$(var right_detection_limit)" />
        <param name="forward_speed" value="$(var forward_speed)" />
        <param name="turn_speed" value="$(var turn_speed)" />
    </node>
</launch>
