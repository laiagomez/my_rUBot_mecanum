# Shared ROS 2 and service configuration for this robot.
# Change only ROS_DOMAIN_ID for each robot/group.
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
ROS_LOCALHOST_ONLY=0

# Repository cloned on the Raspberry Pi.
ROBOT_WORKSPACE=/home/ubuntu/my_rUBot_mecanum

# Network ports exposed by the robot services.
ROSBRIDGE_PORT=9090
WEB_PORT=8000

# Optional CycloneDDS configuration.
# CYCLONEDDS_URI=file:///home/ubuntu/my_rUBot_mecanum/tools/humble_network/cyclonedds_robot.xml
